--- !u!114 &4475370457298509991
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4772648079488699313}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 24fed8c64e4578c42a4973773cf04937, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  dialogueCanvas: {fileID: 6663604696396973230}
  dialogueText: {fileID: 6123815326957802519}
  optionSlots:
  - {fileID: 5200465097222419915}
  - {fileID: 3280591652953212485}
  dialogueNodes:
  - nodeID: 0
    npcResponseText: "Otaah: \u2026 strange, why does the apparition device work
      without a sufficient energy supply?"
    choices:
    - choiceText: Otaah? I have some questions for you.
      nextNodeID: 1
    - choiceText: 'Stop right there, you criminal scum!

'
      nextNodeID: 2
  - nodeID: 1
    npcResponseText: 'Otaah: Oh yes? How can I be of use?'
    choices:
    - choiceText: 'Where were you at the time the energy was cut off?

'
      nextNodeID: 3
  - nodeID: 2
    npcResponseText: "Otaah: \u2026!?!"
    choices:
    - choiceText: 'Where were you at the time the energy was cut off?

'
      nextNodeID: 3
  - nodeID: 3
    npcResponseText: 'Otaah: I have been working on a thesis about paradoxical teleportation
      behaviors. For that, I have been discussing theories with Azneeh.'
    choices:
    - choiceText: Alright then, I will talk to Azneeh.
      nextNodeID: 4
  - nodeID: 4
    npcResponseText: 'Otaah: You can find him on ''Planet B'' by the apparition device
      for humanoid transfer. Just ''explain game mechanic'''
    choices: []
  npcFocusPoint: {fileID: 0}
  focusSpeed: 5
