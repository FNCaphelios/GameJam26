MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4921909851431156258}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 24fed8c64e4578c42a4973773cf04937, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  dialogueCanvas: {fileID: 6879224152368284201}
  dialogueText: {fileID: 5067291728485035250}
  optionSlots:
  - {fileID: 2155164896834522155}
  - {fileID: 5964141943488272288}
  - {fileID: 4925056890871391942}
  dialogueNodes:
  - nodeID: 0
    npcResponseText: "Tikai: That seems strange\u2026"
    choices:
    - choiceText: What do you mean by 'strange'?
      nextNodeID: 1
    - choiceText: 'The only strange thing I see is you!

'
      nextNodeID: 2
    - choiceText: 'Why are you standing around like that?

'
      nextNodeID: 3
  - nodeID: 1
    npcResponseText: 'Tikai: Huh? That is none of your concern! Who even are you?'
    choices:
    - choiceText: I am with the press. Tell me Tikai, where were you when the power
        went out?
      nextNodeID: 4
  - nodeID: 2
    npcResponseText: 'Tikai: Who even are you? Leave me alone!'
    choices:
    - choiceText: I am with the press. Tell me Tikai, where were you when the power
        went out?
      nextNodeID: 4
  - nodeID: 3
    npcResponseText: 'Tikai: Can''t a sigma stand around in peace anymore?'
    choices:
    - choiceText: 'Only if you answer me the following question: where were you when
        the power went out?'
      nextNodeID: 4
  - nodeID: 4
    npcResponseText: 'Tikai: I don''t think I need to explain myself to you. Why
      do you even want to know this?'
    choices:
    - choiceText: I'm looking for the person responsible for the blackout and I think
        it might have been you.
      nextNodeID: 5
  - nodeID: 5
    npcResponseText: 'Tikai: Bullshit, why would you even think it was somebody''s
      fault in the first place?'
    choices: []
  npcFocusPoint: {fileID: 0}
  focusSpeed: 5
