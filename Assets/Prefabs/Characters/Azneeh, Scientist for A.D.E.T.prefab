  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3749874509984168121}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 24fed8c64e4578c42a4973773cf04937, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  dialogueCanvas: {fileID: 4211521811966633939}
  dialogueText: {fileID: 3202104463201645410}
  optionSlots:
  - {fileID: 6435076243154398945}
  - {fileID: 2444514591274520324}
  - {fileID: 7819254549987748654}
  dialogueNodes:
  - nodeID: 0
    npcResponseText: "Azneeh: Seems cable b-3 is intact as well\u2026\r\n"
    choices:
    - choiceText: You have to be Azneeh, I have a few questions to ask, do you have
        a moment?
      nextNodeID: 1
    - choiceText: ' Don''t move, don''t do anything stupid!'
      nextNodeID: 2
  - nodeID: 1
    npcResponseText: 'Azneeh: Questions for me? Well, go ahead.'
    choices:
    - choiceText: 'What are you doing here?

'
      nextNodeID: 3
  - nodeID: 2
    npcResponseText: "Azneeh:  Whaa\u2026 I... I haven't done anything wrong. What
      is it you want from me?\r\n"
    choices:
    - choiceText: What are you doing here?
      nextNodeID: 3
  - nodeID: 3
    npcResponseText: 'Azneeh: I''m studying the cables to investigate whether the
      power shortage is because of broken wiring.'
    choices:
    - choiceText: I see. What did you do during the start of the blackout?
      nextNodeID: 4
  - nodeID: 4
    npcResponseText: 'Azneeh: I have been occupied with studies of Otaah''s new theories.
      Which, if you ask me, are rather imprudent!'
    choices: []
  npcFocusPoint: {fileID: 0}
  focusSpeed: 5
